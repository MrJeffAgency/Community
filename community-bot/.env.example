# Copy this file to .env and fill in your own values.
# Get the token from Community Chat → Me → Community bots → BotFather (/newbot or /token).

COMMUNITY_BOT_TOKEN=cmb_your_bot_token
# Same token. Used for /search, /storage and /save.
COMMUNITY_API_KEY=cmb_your_bot_token

COMMUNITY_API_URL=https://community-bot-api.hdo-box.workers.dev
API_AUTH_HEADER=Authorization
API_AUTH_SCHEME=Bearer

API_SEARCH_PATH=/search
API_STORAGE_PATH=/storage
API_SAVE_PATH=/save
API_TIMEOUT_SECONDS=15

# Seconds between polls (default 1.5).
COMMUNITY_POLL_INTERVAL=1.5

# Optional IANA timezone, e.g. Europe/London. Blank means system local time.
BOT_TIMEZONE=
LOG_LEVEL=INFO
